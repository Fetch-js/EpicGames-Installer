{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epic Games Launcher Setup",
  "version": "1.0.0",
  "identifier": "com.epicgames.launcher.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Epic Games Launcher Setup",
        "width": 1040,
        "height": 680,
        "minWidth": 650,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
